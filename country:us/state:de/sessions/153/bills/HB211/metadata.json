  "abstracts": [
    {
      "note": "synopsis",
      "abstract": "This Substitute for House Bill 211 creates the Innovate Delaware Program. This Program allows an Economic Development Organization to apply for a tax credit program through the Division of Small Business. \r\nThis Substitute also lowers the cap on appropriations to support the tax credit program from 10 million to 3 million dollars in a calendar year."
    }
  ],
